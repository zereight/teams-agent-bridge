<?xml version="1.0" encoding="UTF-8"?>
<!--
  예시 launchd 에이전트 (설치되지 않음, 참고용).

  주의: launchd 로 백그라운드 실행하면 '손쉬운 사용/화면 기록' 권한과 로그인 세션
  문제로 computer use 가 동작하지 않을 수 있어요. 보통은 ./run_mac.sh 로 로그인한
  터미널에서 포그라운드 실행을 권해요. 꼭 써야 하면 아래를 참고하세요.

  설치하려면 (직접 판단해서):
    1) ProgramArguments 경로를 본인 사용자 경로로 고치기
    2) 이 파일을 ~/Library/LaunchAgents/com.user.teams-agent-bridge.plist 로 복사
    3) launchctl load ~/Library/LaunchAgents/com.user.teams-agent-bridge.plist
  내리려면:
    launchctl unload ~/Library/LaunchAgents/com.user.teams-agent-bridge.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.teams-agent-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/CHANGE_ME/teams-agent-bridge/.venv/bin/python</string>
        <string>/Users/CHANGE_ME/teams-agent-bridge/bridge.py</string>
        <string>--config</string>
        <string>/Users/CHANGE_ME/teams-agent-bridge/config.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/CHANGE_ME/teams-agent-bridge</string>

    <!-- 비밀값은 파일에 넣지 말고, 필요하면 Keychain(config 의 *_keychain_*)에서 읽게 하세요. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/CHANGE_ME/teams-agent-bridge/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/CHANGE_ME/teams-agent-bridge/data/launchd.err.log</string>
</dict>
</plist>
